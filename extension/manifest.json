{
  "manifest_version": 3,
  "name": "e-Yazışma İmza",
  "version": "0.1.3",
  "description": "e-Yazışma portallarındaki elektronik imza işlemini yerel kart uygulamasına bağlar.",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "icons": {
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.lkd.org.tr/admin/correspondence/*",
        "https://portal.pkd.org.tr/admin/correspondence/*",
        "https://*.eyazisma.com.tr/*"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "common.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "eyazisma-imza@bahricanli.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "author": "BahriCanli"
}
